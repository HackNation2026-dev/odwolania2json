                "bbox",
                "tekst_w_dokumencie",
                "etykieta_pola",
                "etykieta_roli",
                "liczba_linii"
              ],
              "properties": {
                "strona": {
                  "type": "integer",
                  "minimum": 1
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
