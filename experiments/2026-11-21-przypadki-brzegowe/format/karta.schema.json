                        "przed",
                        "po",
                        "brak"
                      ]
                    },
                    "odleglosc_linii": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "strona": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "bbox": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    }
