                  }
                },
                "wysokosc_linii": {
                  "type": "number"
                }
              }
            }
          },
          "spojna": {
            "type": "boolean"
          },
          "pola_zlokalizowane": {
            "type": "integer"
          },
          "pola_do_lokalizacji": {
            "type": "integer"
          }
        }
