# Skopiuj do .env, ustaw ścieżkę do klucza poza repozytorium i wczytaj konfigurację w sh:
#   set -a
#   . ./.env
#   set +a
# Konfiguracja MiniMax używana przez `python -m odwolania2json process input output`.
LLM_BASE_URL=https://api.minimax.io/anthropic/v1/messages
LLM_MODEL=MiniMax-M3.1-Flash
LLM_PROTOCOL=anthropic
LLM_API_KEY_FILE="${HOME}/.config/odwolania2json/minimax.key"
# Hosty, do których wolno wysłać klucz i treść dokumentów (po przecinku).
# LLM_ALLOWED_HOSTS=api.minimax.io,opencode.ai

# Dostawca zapasowy (opcjonalny, ADR-007). Zgodność z wymogiem UE/EOG jest nieznana:
# decyzję o użyciu podejmuje człowiek. Klucz tylko w pliku lub zmiennej, nigdy w repozytorium.
# LLM_FALLBACK_BASE_URL=https://opencode.ai/inference/go/openai/v1
# LLM_FALLBACK_MODEL=glm-5.3-flash
# LLM_FALLBACK_PROTOCOL=openai
# LLM_FALLBACK_KEY_FILE=~/kluczOpenCodeGLM
# LLM_FALLBACK_HEADERS={"x-opencode-session": "{session}"}
# LLM_FALLBACK_USER_AGENT=

# Jedyna obsługiwana baza: SQLite przez SQLAlchemy (ADR-004).
DATABASE_URL=sqlite:///odwolania2json.db
WORK_DIR=work
OCR_ENABLED=1
